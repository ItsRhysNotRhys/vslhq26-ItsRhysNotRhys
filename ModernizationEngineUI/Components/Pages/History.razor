@page "/history"
@rendermode InteractiveServer
@inject ModernizationHistoryService HistoryService
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>Modernization History</PageTitle>

<div class="container-fluid bg-dark text-light p-3" style="min-height: 100vh;">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Session History</h2>
        <button class="btn btn-outline-light" @onclick="HistoryService.Clear" disabled="@(HistoryService.Entries.Count == 0)">
            Clear History
        </button>
    </div>

    @if (HistoryService.Entries.Count == 0)
    {
        <p class="text-secondary">No modernization requests yet in this session. Run a refactor from the <a href="/" data-enhance-nav="false">Home</a> page to see it show up here.</p>
    }
    else
    {
        @foreach (var entry in HistoryService.Entries)
        {
            <div class="card text-light mb-3" style="background-color: #2a2a2a; border: 1px solid #555;">
                <div class="card-header d-flex justify-content-between align-items-center" style="background-color: #333; border-bottom: 1px solid #555;">
                    <span>
                        <strong>@entry.Timestamp.ToString("HH:mm:ss")</strong>
                        &mdash; @entry.PatternDescription
                    </span>
                    <span>
                        <span class="badge @SeverityBadgeClass(entry.Severity) me-2">@entry.Severity</span>
                        @if (entry.BuildSucceeded)
                        {
                            <span class="badge bg-success">✅ Compiled</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">❌ Failed</span>
                        }
                    </span>
                </div>
                <div class="card-body">
                    <p class="mb-2">@entry.Explanation</p>
                    <details>
                        <summary class="text-info" style="cursor: pointer;">View original / modernized code</summary>
                        <div class="row mt-2">
                            <div class="col-6">
                                <div class="small text-light opacity-75 mb-1">Original</div>
                                <pre class="bg-black text-light p-2" style="max-height: 300px; overflow: auto;"><code>@entry.OriginalCode</code></pre>
                            </div>
                            <div class="col-6">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <div class="small text-light opacity-75">Modernized</div>
                                    <button class="btn btn-sm btn-outline-light py-0 px-2" @onclick="() => CopyToClipboard(entry)">
                                        @(ReferenceEquals(_lastCopiedEntry, entry) ? "Copied!" : "Copy")
                                    </button>
                                </div>
                                <pre class="bg-black text-light p-2" style="max-height: 300px; overflow: auto;"><code>@entry.ModernizedCode</code></pre>
                            </div>
                        </div>
                    </details>
                </div>
            </div>
        }
    }
</div>

@code {
    protected override void OnInitialized()
    {
        HistoryService.Changed += OnHistoryChanged;
    }

    private void OnHistoryChanged() => InvokeAsync(StateHasChanged);

    private static string SeverityBadgeClass(string severity) => severity switch
    {
        "High" => "bg-danger",
        "Medium" => "bg-warning text-dark",
        "Low" => "bg-success",
        _ => "bg-secondary"
    };

    private HistoryEntry? _lastCopiedEntry;

    private async Task CopyToClipboard(HistoryEntry entry)
    {
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", entry.ModernizedCode);
        _lastCopiedEntry = entry;
        StateHasChanged();

        await Task.Delay(1500);
        if (ReferenceEquals(_lastCopiedEntry, entry))
        {
            _lastCopiedEntry = null;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        HistoryService.Changed -= OnHistoryChanged;
    }
}
